# ===================================
# إضافات مقترحة لملف .env للشهادات
# ===================================

# 1. إعدادات Browsershot المحددة لنظام Linux (مفضلة على الإعدادات العامة)
BROWSERSHOT_NODE_PATH_LINUX=/usr/bin/node
BROWSERSHOT_CHROME_PATH_LINUX=/usr/bin/google-chrome

# 2. إعدادات البريد الإلكتروني (مطلوبة لإرسال الشهادات)
# يجب تكوينها حسب خدمة البريد الإلكتروني المستخدمة
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ofuq.academy
MAIL_FROM_NAME="${APP_NAME}"

# 3. إعدادات التخزين (للتأكد من حفظ الشهادات بشكل صحيح)
FILESYSTEM_DISK=public

# 4. إعدادات Queue (للتأكد من معالجة الشهادات في الخلفية)
# QUEUE_CONNECTION=database (موجود بالفعل ✓)

# 5. إعدادات إضافية للأمان والأداء
BROWSERSHOT_TIMEOUT=60
BROWSERSHOT_DELAY=0

# ===================================
# ملاحظات مهمة:
# ===================================
# 1. تأكد من تشغيل queue worker: php artisan queue:work
# 2. تأكد من وجود مجلد storage/app/public/certificates وأنه قابل للكتابة
# 3. تأكد من تشغيل: php artisan storage:link
# 4. للاختبار: php artisan queue:work --once
